<style>
    :root {
        --bg: #f6f7fb;
        --card: #ffffff;
        --muted: #6b7280;
        --accent: #111827;
        --primary: #0066cc;
        --danger: #e11d48;
        --radius: 10px;
        --gap: 18px;
        font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }

    html,
    body {
        height: 100%;
        margin: 0;
        background: var(--bg);
        color: var(--accent);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .wrap {
        max-width: 1100px;
        margin: 40px auto;
        padding: 24px;
    }

    .cart {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: var(--gap);
        align-items: start;
    }

    /* card */
    .card {
        background: var(--card);
        border-radius: var(--radius);
        padding: 20px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    }

    h1 {
        margin: 0 0 12px 0;
        font-size: 20px;
        letter-spacing: -0.2px;
    }

    .cart-items {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 8px;
    }

    .item {
        display: flex;
        gap: 14px;
        align-items: center;
        padding: 10px;
        border-radius: 8px;
        background: linear-gradient(180deg, #fff, #fbfdff);
        border: 1px solid rgba(15, 23, 42, 0.03);
    }

    .img-placeholder {
        width: 92px;
        height: 92px;
        border-radius: 8px;
        background: linear-gradient(135deg, #e6eefc, #f2f7ff);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted);
        font-weight: 600;
        font-size: 12px;
        flex-shrink: 0;
        border: 1px dashed rgba(0, 0, 0, 0.04);
    }

    .item-meta {
        flex: 1;
        min-width: 0;
    }

    .item-title {
        font-weight: 600;
        font-size: 15px;
        margin: 0 0 6px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .item-desc {
        margin: 0;
        font-size: 13px;
        color: var(--muted);
    }

    .item-controls {
        text-align: right;
        min-width: 120px;
    }

    .price {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .qty {
        display: inline-block;
        padding: 6px 8px;
        border-radius: 6px;
        background: #f3f4f6;
        color: var(--muted);
        font-size: 13px;
    }

    .remove {
        display: block;
        margin-top: 8px;
        font-size: 13px;
        color: var(--danger);
        text-decoration: none;
    }

    /* summary column */
    .summary {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .summary .totals {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 12px;
        border-radius: 8px;
        background: linear-gradient(180deg, #fff, #fbfdff);
    }

    .row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--muted);
        font-size: 14px;
    }

    .row.total {
        font-weight: 700;
        font-size: 17px;
        color: var(--accent);
    }

    .checkout {
        display: block;
        text-align: center;
        background: var(--primary);
        color: #fff;
        padding: 12px 14px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        border: none;
        cursor: not-allowed;
        opacity: 0.95;
    }

    .note {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.4;
    }

    /* empty state */
    .empty {
        text-align: center;
        padding: 40px;
        color: var(--muted);
    }

    /* responsive */
    @media (max-width:920px) {
        .cart {
            grid-template-columns: 1fr;
        }

        .summary {
            order: 2;
        }
    }
</style>


<div class="wrap">
    <div class="cart">
        <class="card">
            <h1>Your cart</h1>

            {% for item in cart.items %}
            <div class="cart-items">
                <div class="item">
                    <img src="{{item.image | img_url: width: 300}}" alt="{{item.title}}">
                    <div class="item-meta">
                        <p class="item-title">{{item.title}}</p>
                        <p class="item-desc">Variant / Size / Color</p>
                    </div>
                    <div class="item-controls">
                        <div class="price">{{item.price | money}}</div>
                        <input type="number" name="qty" id="" value={{item.quantity}} class="qty">
                        <a class="remove" href="#">Remove</a>
                    </div>
                </div>
            {% endfor %}

        <aside class="summary">
            <div class="card totals">
                <hr style="border:none;border-top:1px solid rgba(15,23,42,0.06);margin:6px 0;">
                <div class="row total">
                    <span>Total</span>
                    <span>{{cart.total_price | money}}</span>
                </div>
            </div>
            <div class="card">
                <a href="/checkout" class="checkout" disabled>Proceed to checkout</a>
            </div>
        </aside>
    </main>
    </div>
</div>