{%- comment -%}
    cart-drawer.liquid
    Simple cart drawer snippet with CSS (at top), HTML using Liquid to list cart items,
    and JavaScript to open/close the drawer and remove items (uses /cart/change.js).
    - CSS is inside <style> at the top as requested.
    - Keep this snippet lightweight and easy to understand.
{%- endcomment -%}

<style>
    /* Overlay behind the drawer */
    .cart-drawer__overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease;
        z-index: 999;
    }

    /* Drawer panel (right side) */
    .cart-drawer {
        position: fixed;
        top: 0;
        right: 0;
        height: 100%;
        width: 360px;
        max-width: 100%;
        background: #fff;
        box-shadow: -16px 0 30px rgba(0,0,0,0.15);
        transform: translateX(110%);
        transition: transform 0.25s ease;
        z-index: 1000;
        display: flex;
        flex-direction: column;
    }

    /* When active, show overlay + drawer */
    .cart-drawer--open .cart-drawer__overlay {
        opacity: 1;
        visibility: visible;
    }
    .cart-drawer--open .cart-drawer {
        transform: translateX(0);
    }

    /* Drawer header */
    .cart-drawer__header {
        padding: 16px;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .cart-drawer__title {
        font-weight: 600;
        font-size: 16px;
    }
    .cart-drawer__close {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
    }

    /* Items container */
    .cart-drawer__items {
        padding: 12px;
        overflow: auto;
        flex: 1 1 auto;
    }
    .cart-drawer__item {
        display: flex;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid #f4f4f4;
        align-items: center;
    }
    .cart-drawer__item img {
        width: 64px;
        height: 64px;
        object-fit: cover;
        border-radius: 4px;
    }
    .cart-drawer__item-info {
        flex: 1 1 auto;
        min-width: 0;
    }
    .cart-drawer__item-title {
        font-size: 14px;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .cart-drawer__item-meta {
        font-size: 13px;
        color: #666;
    }
    .cart-drawer__remove {
        background: none;
        border: none;
        color: #c00;
        cursor: pointer;
        font-size: 13px;
    }

    /* Footer with subtotal and actions */
    .cart-drawer__footer {
        padding: 12px;
        border-top: 1px solid #eee;
    }
    .cart-drawer__subtotal {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-weight: 600;
    }
    .cart-drawer__actions {
        display: flex;
        gap: 8px;
    }
    .button {
        padding: 10px 12px;
        border: none;
        cursor: pointer;
        border-radius: 4px;
        font-weight: 600;
    }
    .button--primary {
        background: #111;
        color: #fff;
        flex: 1;
    }
    .button--secondary {
        background: #fff;
        border: 1px solid #ddd;
        flex: 1;
    }

    /* Simple responsive tweak */
    @media (max-width: 420px) {
        .cart-drawer { width: 100%; }
    }
</style>
<!--
    Markup:
    - .cart-drawer-root is a wrapper that gets class .cart-drawer--open when opened.
    - There is an overlay and the drawer panel itself.
    - Use elements with class "open-cart-drawer" to open the drawer (example provided).
-->
<div id="cart-drawer-root" class="cart-drawer-root">
    <!-- Overlay (click to close) -->
    <div class="cart-drawer__overlay" data-close-cart-drawer></div>

    <!-- The drawer panel -->
    <aside class="cart-drawer" role="dialog" aria-labelledby="cart-drawer-title" aria-modal="true">
        <div class="cart-drawer__header">
            <div id="cart-drawer-title" class="cart-drawer__title">Your cart</div>
            <button class="cart-drawer__close" aria-label="Close cart" data-close-cart-drawer>&times;</button>
        </div>

        <!-- Items list (rendered server-side using Liquid) -->
        <div class="cart-drawer__items" id="cart-drawer-items">
            {%- if cart.item_count == 0 -%}
                <div>
                    <p class="cart-drawer__empty" style="padding: 12px; color:#666;">Your cart is empty.</p>
                </div>
                <div class="cart-drawer__footer" style="display : none;">
                    <div class="cart-drawer__subtotal">
                        <span>Subtotal</span>
                        <span id="cart-drawer-subtotal">{{ cart.total_price | money }}</span>
                    </div>
                    <div class="cart-drawer__actions">
                        <!-- Checkout link -->
                        <a href="/checkout" class="button button--primary">Checkout</a>
                    </div>
                </div>



            {%- else -%}
                {%- for item in cart.items -%}
                    <div class="cart-drawer__item" data-line="{{ forloop.index }}">
                        <!-- Product image -->
                        <img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title }}" />

                        <!-- Title, variant and price -->
                        <div class="cart-drawer__item-info">
                            <div class="cart-drawer__item-title">{{ item.product.title }}</div>
                            <div class="cart-drawer__item-meta">
                                {{ item.variant_title }} • {{ item.price | money }}
                            </div>

                            <!-- Quantity controls: decrease, current qty (readonly), increase -->
                            <div class="cart-drawer__quantity" aria-label="Quantity controls">
                                <button
                                    type="button"
                                    class="cart-drawer__qty-btn"
                                    data-qty-decrease="{{ forloop.index }}"
                                    aria-label="Decrease quantity"
                                >−</button>

                                <input
                                    type="text"
                                    class="cart-drawer__qty-input"
                                    data-qty-line="{{ forloop.index }}"
                                    value="{{ item.quantity }}"
                                    inputmode="numeric"
                                    aria-label="Quantity"
                                    readonly
                                />

                                <button
                                    type="button"
                                    class="cart-drawer__qty-btn"
                                    data-qty-increase="{{ forloop.index }}"
                                    aria-label="Increase quantity"
                                >+</button>
                            </div>
                        </div>

                        <!-- Remove button: uses the line number (1-based) to remove via /cart/change.js -->
                        <button class="cart-drawer__remove" data-remove-line="{{ forloop.index }}" aria-label="Remove item">
                            Remove
                        </button>
                    </div>
                {%- endfor -%}
            {%- endif -%}
        </div>

        <!-- Footer with subtotal and action buttons -->
        <div class="cart-drawer__footer">
            <div class="cart-drawer__subtotal">
                <span>Subtotal</span>
                <span id="cart-drawer-subtotal">{{ cart.total_price | money }}</span>
            </div>
            <div class="cart-drawer__actions">
                <!-- Checkout link -->
                <a href="/checkout" class="button button--primary">Checkout</a>
            </div>
        </div>
    </aside>
</div>

<!-- Example trigger (you can remove this and use your own cart icon/button with class open-cart-drawer) -->
<button class="open-cart-drawer button button--secondary" style="position:fixed; right:16px; bottom:16px; z-index: 1100;">
    Open cart
</button>


<script>
    // Simple JS to open/close drawer and to remove items.
    (function() {
        // Root element that will receive the .cart-drawer--open class
        var root = document.getElementById('cart-drawer-root');
        var openButtons = document.querySelectorAll('.open-cart-drawer');
        var closeButtons = document.querySelectorAll('[data-close-cart-drawer]');
        var removeButtons = document.querySelectorAll('[data-remove-line]');

        // Open drawer
        function openDrawer() {
            root.classList.add('cart-drawer--open');
            // Lock body scroll
            document.body.style.overflow = 'hidden';
        }

        // Close drawer
        function closeDrawer() {
            root.classList.remove('cart-drawer--open');
            document.body.style.overflow = '';
        }

        // Attach listeners to open buttons
        openButtons.forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                openDrawer();
            });
        });

        // Attach listeners to close buttons / overlay
        closeButtons.forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                closeDrawer();
            });
        });

        // Close on Escape key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeDrawer();
        });

        document.addEventListener("product:added", function() {
            openDrawer();
            document.querySelector(".cart-drawer__footer").style.display = "block";
        });

        document.querySelectorAll('.remove').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
            console.log(btn);
        })


        // Remove item by line index (simple approach using /cart/change.js).
        // After successful change we reload the page to get updated cart HTML.
        removeButtons.forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                var line = btn.getAttribute('data-remove-line');
                if (!line) return;
                // Simple confirm (optional)
                if (!confirm('Remove this item from your cart?')) return;

                // POST to /cart/change.js with line and quantity 0 to remove
                fetch('/cart/change.js', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: 'line=' + encodeURIComponent(line) + '&quantity=0'
                })
                .then(function(res) {
                    if (!res.ok) throw new Error('Network response was not ok');
                    return res.json();
                })
                .then(function(cart) {
                    // Simple approach: reload page to reflect updated cart on the server
                    window.location.reload();
                })
                .catch(function(err) {
                    console.error('Error removing item:', err);
                    alert('Unable to remove item. Please try again.');
                });
            });
        });

        // Note: If your theme updates the DOM after ajax cart events, you may need to
        // re-query removeButtons and re-bind events, or convert event binding above to
        // use event delegation for dynamic content.
    })();
</script>